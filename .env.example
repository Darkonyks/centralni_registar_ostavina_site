# ─────────────────────────────────────────────────────────────────────────────
# Primer konfiguracije. Kopirati u `.env` (produkcija, `npm start`) ili
# `.env.local` (razvoj, `npm run dev`) i upisati prave vrednosti.
# `.env` i `.env.*` fajlovi su u .gitignore – tajne NIKADA ne idu u repozitorijum.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (ugrađuje se u JavaScript pri build-u; javne vrednosti) ─────────
# Javni Turnstile site key (Cloudflare dashboard → Turnstile → widget).
# Test ključ koji uvek prolazi: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Opcione zamene Demo/Aplikacija linkova (npr. za staging).
VITE_DEMO_URL=
VITE_APP_URL=

# ── Server (samo na serveru; NIKADA sa prefiksom VITE_) ──────────────────────
# Turnstile secret key. Test ključ koji uvek prolazi: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Adresa na koju stižu obaveštenja o upitima iz kontakt forme.
CONTACT_RECIPIENT_EMAIL=kontakt@registarostavina.rs

# SMTP nalog za slanje. FROM mora biti adresa na domenu podešenom za slanje (SPF/DKIM),
# npr. noreply@registarostavina.rs. Email korisnika ide samo u Reply-To.
SMTP_HOST=
# 587 uz SMTP_SECURE=false (STARTTLS) ili 465 uz SMTP_SECURE=true (TLS)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Odbija slanje ako SMTP server ne ponudi STARTTLS (podrazumevano true).
# Na false postaviti samo za lokalni test server (npm run dev:smtp).
SMTP_REQUIRE_TLS=true

# SQLite baza sa upitima, saglasnostima za kolačiće i admin sesijama.
# U produkciji mora biti na trajnom disku/volumenu (npr. /app/data/registar.db u Docker-u).
DATABASE_PATH=data/registar.db

# Administracija (/admin/). Heš lozinke se pravi komandom: npm run admin:hash-password
# (lozinka se nigde ne čuva u čistom obliku; heš ne sadrži znak $).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Produkcioni server (npm start)
PORT=3000
HOST=0.0.0.0
# Header sa stvarnom IP adresom klijenta iza proxy-ja (rate limit, skraćena IP u evidenciji kolačića).
# Iza Cloudflare-a: cf-connecting-ip; iza nginx-a/Traefik-a: x-forwarded-for.
# Ostaviti prazno ako server nije iza proxy-ja (header bi inače mogao da se lažira).
CLIENT_IP_HEADER=
